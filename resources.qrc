<RCC>
    <qresource prefix="/">
        <file alias="icons/app.ico">resources/icons/app.ico</file>
        <file alias="icons/app.png">resources/icons/app.png</file>
        <file alias="styles.qss">resources/styles/styles.qss</file>
        <file alias="styles-dark.qss">resources/styles/styles-dark.qss</file>
    </qresource>
</RCC>
