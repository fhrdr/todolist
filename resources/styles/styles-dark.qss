/* ==========================================================
   Todo List 深色全局样式 —— 与 src/ui/theme.h 深色令牌保持一致
   风格：深海军蓝底、柔和亮蓝主色
   ========================================================== */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", -apple-system, sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog {
    background-color: #0f1726;
}

QWidget {
    color: #e6ecf5;
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background-color: #212c42;
    border: 2px solid #608cfa;
    border-radius: 8px;
    color: #8fb0ff;
    padding: 9px 18px;
    font-weight: 500;
    min-width: 72px;
}

QPushButton:hover {
    background-color: #253555;
}

QPushButton:pressed {
    background-color: #253555;
}

QPushButton:disabled {
    background-color: #1a2335;
    color: #6b7a90;
    border-color: #2e3b52;
}

/* 实心主按钮 */
QPushButton[variant="primary"] {
    background-color: #608cfa;
    border: none;
    color: #0f1726;
}
QPushButton[variant="primary"]:hover  { background-color: #3b82f6; color: #ffffff; }
QPushButton[variant="primary"]:pressed { background-color: #2563eb; color: #ffffff; }
QPushButton[variant="primary"]:disabled { background-color: #3f4e69; color: #9aa8bc; }

/* 危险按钮 */
QPushButton[variant="danger"] {
    border-color: #f87171;
    color: #f87171;
}
QPushButton[variant="danger"]:hover  { background-color: #3a2530; }
QPushButton[variant="danger"]:pressed { background-color: #462b38; }

/* 成功按钮 */
QPushButton[variant="success"] {
    border-color: #34d399;
    color: #34d399;
}
QPushButton[variant="success"]:hover  { background-color: #1d3130; }
QPushButton[variant="success"]:pressed { background-color: #24403c; }

/* 幽灵小按钮（无框图标按钮） */
QPushButton[variant="ghost"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #9aa8bc;
    min-width: 0;
    padding: 6px;
}
QPushButton[variant="ghost"]:hover  { background-color: #212c42; color: #8fb0ff; }
QPushButton[variant="ghost"]:pressed { background-color: #2e3b52; }

/* ---------------- 列表 ---------------- */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    background-color: transparent;
    border: none;
    color: #e6ecf5;
}

/* ---------------- 输入框 ---------------- */
QLineEdit {
    border: 1px solid #2e3b52;
    border-radius: 8px;
    padding: 10px 14px;
    background-color: #1a2335;
    color: #e6ecf5;
    selection-background-color: #253555;
    selection-color: #c7d8ff;
}

QLineEdit:focus  { border-color: #608cfa; }
QLineEdit:disabled { background-color: #212c42; color: #6b7a90; }
QLineEdit::placeholder { color: #6b7a90; }

QTextEdit {
    border: 1px solid #2e3b52;
    border-radius: 8px;
    padding: 10px;
    background-color: #1a2335;
    color: #e6ecf5;
    selection-background-color: #253555;
    selection-color: #c7d8ff;
}

QTextEdit:focus  { border-color: #608cfa; }
QTextEdit:disabled { background-color: #212c42; color: #6b7a90; }

/* ---------------- 复选框 ---------------- */
QCheckBox {
    spacing: 8px;
    color: #e6ecf5;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid #3f4e69;
    background-color: #1a2335;
}

QCheckBox::indicator:hover { border-color: #608cfa; }

QCheckBox::indicator:checked {
    background-color: #608cfa;
    border-color: #608cfa;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iMTIiIHZpZXdCb3g9IjAgMCAxMiAxMiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMTAgM0w0LjUgOC41TDIgNiIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
}

QCheckBox::indicator:disabled {
    background-color: #212c42;
    border-color: #2e3b52;
}

/* ---------------- 下拉框 ---------------- */
QComboBox {
    border: 1px solid #2e3b52;
    border-radius: 8px;
    padding: 9px 32px 9px 14px;
    background-color: #1a2335;
    color: #e6ecf5;
    min-width: 100px;
}

QComboBox:hover, QComboBox:focus { border-color: #608cfa; }

QComboBox::drop-down {
    border: none;
    width: 26px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iMTIiIHZpZXdCb3g9IjAgMCAxMiAxMiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMyA0LjVMNiA3LjVMOSA0LjUiIHN0cm9rZT0iIzY0NzQ4YiIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #1a2335;
    border: 1px solid #2e3b52;
    border-radius: 8px;
    selection-background-color: #1e2a44;
    selection-color: #e6ecf5;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 9px 12px;
    border-radius: 6px;
    color: #e6ecf5;
    border: none;
    outline: none;
}

QComboBox QAbstractItemView::item:hover { background-color: #212c42; }

/* ---------------- 标签 ---------------- */
QLabel {
    color: #e6ecf5;
    background-color: transparent;
}

/* ---------------- 滚动区 / 滚动条 ---------------- */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #3f4e69;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover { background-color: #6b7a90; }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #3f4e69;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover { background-color: #6b7a90; }

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------------- 分割器 ---------------- */
QSplitter::handle { background-color: transparent; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }
QSplitter::handle:hover      { background-color: #2e3b52; }

/* ---------------- 提示框 ---------------- */
QToolTip {
    background-color: #e6ecf5;
    color: #1a2335;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ---------------- 菜单 ---------------- */
QMenu {
    background-color: #1a2335;
    border: 1px solid #2e3b52;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 9px 28px 9px 14px;
    border-radius: 6px;
    color: #e6ecf5;
}

QMenu::item:selected {
    background-color: #1e2a44;
    color: #8fb0ff;
}

QMenu::separator {
    height: 1px;
    background-color: #2e3b52;
    margin: 5px 10px;
}

/* ---------------- 状态栏 ---------------- */
QStatusBar {
    background-color: #1a2335;
    border-top: 1px solid #2e3b52;
    color: #9aa8bc;
    padding: 4px 16px;
    font-size: 12px;
}
