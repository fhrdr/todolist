/* ==========================================================
   Todo List 深色全局样式 —— 「暗夜霓虹 · 玻璃拟态」
   与 src/ui/theme.h 深色令牌保持一致
   ========================================================== */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", -apple-system, sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog {
    background-color: #0b0e1a;
}

QWidget {
    color: #eaf0fa;
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(34, 211, 238, 0.55);
    border-radius: 8px;
    color: #67e8f9;
    padding: 9px 18px;
    font-weight: 500;
    min-width: 72px;
}

QPushButton:hover {
    background-color: rgba(34, 211, 238, 0.14);
    border-color: #22d3ee;
}

QPushButton:pressed {
    background-color: rgba(34, 211, 238, 0.22);
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.03);
    color: #6e7e9c;
    border-color: #2e3854;
}

/* 主按钮：主题色描边 + 同色文字 */
QPushButton[variant="primary"] {
    background-color: rgba(34, 211, 238, 0.10);
    border: 1px solid rgba(34, 211, 238, 0.65);
    color: #67e8f9;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover {
    background-color: rgba(34, 211, 238, 0.20);
    border-color: #22d3ee;
    color: #a5f3fc;
}
QPushButton[variant="primary"]:pressed { background-color: rgba(34, 211, 238, 0.28); }
QPushButton[variant="primary"]:disabled {
    background-color: transparent;
    border-color: rgba(148, 163, 184, 0.25);
    color: #515e76;
}

/* 危险按钮 */
QPushButton[variant="danger"] {
    border-color: rgba(248, 113, 113, 0.6);
    color: #f87171;
}
QPushButton[variant="danger"]:hover  { background-color: rgba(248, 113, 113, 0.14); border-color: #f87171; }
QPushButton[variant="danger"]:pressed { background-color: rgba(248, 113, 113, 0.22); }

/* 成功按钮 */
QPushButton[variant="success"] {
    border-color: rgba(52, 211, 153, 0.6);
    color: #34d399;
}
QPushButton[variant="success"]:hover  { background-color: rgba(52, 211, 153, 0.14); border-color: #34d399; }
QPushButton[variant="success"]:pressed { background-color: rgba(52, 211, 153, 0.22); }

/* 幽灵小按钮（无框图标按钮） */
QPushButton[variant="ghost"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #9dacc6;
    min-width: 0;
    padding: 6px;
}
QPushButton[variant="ghost"]:hover  { background-color: rgba(255, 255, 255, 0.08); color: #67e8f9; }
QPushButton[variant="ghost"]:pressed { background-color: rgba(255, 255, 255, 0.14); }

/* ---------------- 列表 ---------------- */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    background-color: transparent;
    border: none;
    color: #eaf0fa;
}

/* ---------------- 输入框 ---------------- */
QLineEdit {
    border: 1px solid #2e3854;
    border-radius: 8px;
    padding: 10px 14px;
    background-color: rgba(255, 255, 255, 0.05);
    color: #eaf0fa;
    selection-background-color: rgba(34, 211, 238, 0.35);
    selection-color: #ffffff;
}

QLineEdit:hover  { border-color: #3d4a6b; }
QLineEdit:focus  { border-color: #22d3ee; background-color: rgba(34, 211, 238, 0.07); }
QLineEdit:disabled { background-color: rgba(255, 255, 255, 0.03); color: #6e7e9c; }
QLineEdit::placeholder { color: #6e7e9c; }

QTextEdit {
    border: 1px solid #2e3854;
    border-radius: 8px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    color: #eaf0fa;
    selection-background-color: rgba(34, 211, 238, 0.35);
    selection-color: #ffffff;
}

QTextEdit:hover  { border-color: #3d4a6b; }
QTextEdit:focus  { border-color: #22d3ee; background-color: rgba(34, 211, 238, 0.07); }
QTextEdit:disabled { background-color: rgba(255, 255, 255, 0.03); color: #6e7e9c; }

/* ---------------- 复选框 ---------------- */
QCheckBox {
    spacing: 8px;
    color: #eaf0fa;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid #3d4a6b;
    background-color: rgba(255, 255, 255, 0.04);
}

QCheckBox::indicator:hover { border-color: #22d3ee; }

QCheckBox::indicator:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #22d3ee, stop:1 #6366f1);
    border-color: #22d3ee;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iMTIiIHZpZXdCb3g9IjAgMCAxMiAxMiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMTAgM0w0LjUgOC41TDIgNiIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
}

QCheckBox::indicator:disabled {
    background-color: rgba(255, 255, 255, 0.03);
    border-color: #2e3854;
}

/* ---------------- 下拉框 ---------------- */
QComboBox {
    border: 1px solid #2e3854;
    border-radius: 8px;
    padding: 9px 32px 9px 14px;
    background-color: rgba(255, 255, 255, 0.05);
    color: #eaf0fa;
    min-width: 100px;
}

QComboBox:hover, QComboBox:focus { border-color: #22d3ee; }

QComboBox::drop-down {
    border: none;
    width: 26px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iMTIiIHZpZXdCb3g9IjAgMCAxMiAxMiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMyA0LjVMNiA3LjVMOSA0LjUiIHN0cm9rZT0iIzY0NzQ4YiIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #171c30;
    border: 1px solid #2e3854;
    border-radius: 8px;
    selection-background-color: rgba(34, 211, 238, 0.18);
    selection-color: #eaf0fa;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 9px 12px;
    border-radius: 6px;
    color: #eaf0fa;
    border: none;
    outline: none;
}

QComboBox QAbstractItemView::item:hover { background-color: rgba(255, 255, 255, 0.07); }

/* ---------------- 标签 ---------------- */
QLabel {
    color: #eaf0fa;
    background-color: transparent;
}

/* ---------------- 滚动区 / 滚动条 ---------------- */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #3d4a6b;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover { background-color: #22d3ee; }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #3d4a6b;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover { background-color: #22d3ee; }

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------------- 分割器 ---------------- */
QSplitter::handle { background-color: transparent; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }
QSplitter::handle:hover      { background-color: rgba(34, 211, 238, 0.35); }

/* ---------------- 提示框 ---------------- */
QToolTip {
    background-color: #eaf0fa;
    color: #14182a;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ---------------- 菜单 ---------------- */
QMenu {
    background-color: rgba(23, 28, 48, 0.98);
    border: 1px solid #2e3854;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 9px 28px 9px 14px;
    border-radius: 6px;
    color: #eaf0fa;
}

QMenu::item:selected {
    background-color: rgba(34, 211, 238, 0.16);
    color: #67e8f9;
}

QMenu::separator {
    height: 1px;
    background-color: #2e3854;
    margin: 5px 10px;
}

/* ---------------- 状态栏 ---------------- */
QStatusBar {
    background-color: rgba(11, 14, 26, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    color: #9dacc6;
    padding: 4px 16px;
    font-size: 12px;
}

/* ---------------- 对话框 ---------------- */
QInputDialog, QMessageBox {
    background-color: #14182a;
}
