/* ==========================================================
   Todo List 浅色全局样式 —— 「琉璃炫彩」
   与 src/ui/theme.h 浅色令牌保持一致
   ========================================================== */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", -apple-system, sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog {
    background-color: #e8edf6;
}

QWidget {
    color: #1e293b;
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(79, 70, 229, 0.5);
    border-radius: 8px;
    color: #4f46e5;
    padding: 9px 18px;
    font-weight: 500;
    min-width: 72px;
}

QPushButton:hover {
    background-color: rgba(79, 70, 229, 0.08);
    border-color: #4f46e5;
}

QPushButton:pressed {
    background-color: rgba(79, 70, 229, 0.16);
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.6);
    color: #94a3b8;
    border-color: #c7d1e3;
}

/* 主按钮：主题色描边 + 同色文字 */
QPushButton[variant="primary"] {
    background-color: rgba(79, 70, 229, 0.08);
    border: 1px solid rgba(79, 70, 229, 0.65);
    color: #4f46e5;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover {
    background-color: rgba(79, 70, 229, 0.16);
    border-color: #4f46e5;
    color: #4338ca;
}
QPushButton[variant="primary"]:pressed { background-color: rgba(79, 70, 229, 0.24); }
QPushButton[variant="primary"]:disabled {
    background-color: transparent;
    border-color: rgba(148, 163, 184, 0.4);
    color: #94a3b8;
}

/* 危险按钮 */
QPushButton[variant="danger"] {
    border-color: rgba(239, 68, 68, 0.6);
    color: #ef4444;
}
QPushButton[variant="danger"]:hover  { background-color: rgba(239, 68, 68, 0.08); border-color: #ef4444; }
QPushButton[variant="danger"]:pressed { background-color: rgba(239, 68, 68, 0.16); }

/* 成功按钮 */
QPushButton[variant="success"] {
    border-color: rgba(16, 185, 129, 0.6);
    color: #10b981;
}
QPushButton[variant="success"]:hover  { background-color: rgba(16, 185, 129, 0.08); border-color: #10b981; }
QPushButton[variant="success"]:pressed { background-color: rgba(16, 185, 129, 0.16); }

/* 幽灵小按钮（无框图标按钮） */
QPushButton[variant="ghost"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #64748b;
    min-width: 0;
    padding: 6px;
}
QPushButton[variant="ghost"]:hover  { background-color: rgba(79, 70, 229, 0.08); color: #4f46e5; }
QPushButton[variant="ghost"]:pressed { background-color: rgba(79, 70, 229, 0.14); }

/* ---------------- 列表 ---------------- */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    background-color: transparent;
    border: none;
    color: #1e293b;
}

/* ---------------- 输入框 ---------------- */
QLineEdit {
    border: 1px solid #c7d1e3;
    border-radius: 8px;
    padding: 10px 14px;
    background-color: rgba(255, 255, 255, 0.9);
    color: #1e293b;
    selection-background-color: #c7d2fe;
    selection-color: #312e81;
}

QLineEdit:hover  { border-color: #cbd5e1; }
QLineEdit:focus  { border-color: #4f46e5; background-color: #ffffff; }
QLineEdit:disabled { background-color: #f1f5f9; color: #94a3b8; }
QLineEdit::placeholder { color: #94a3b8; }

QTextEdit {
    border: 1px solid #c7d1e3;
    border-radius: 8px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.9);
    color: #1e293b;
    selection-background-color: #c7d2fe;
    selection-color: #312e81;
}

QTextEdit:hover  { border-color: #cbd5e1; }
QTextEdit:focus  { border-color: #4f46e5; background-color: #ffffff; }
QTextEdit:disabled { background-color: #f1f5f9; color: #94a3b8; }

/* ---------------- 复选框 ---------------- */
QCheckBox {
    spacing: 8px;
    color: #1e293b;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid #cbd5e1;
    background-color: #ffffff;
}

QCheckBox::indicator:hover { border-color: #4f46e5; }

QCheckBox::indicator:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #4f46e5, stop:1 #06b6d4);
    border-color: #4f46e5;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iMTIiIHZpZXdCb3g9IjAgMCAxMiAxMiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMTAgM0w0LjUgOC41TDIgNiIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
}

QCheckBox::indicator:disabled {
    background-color: #f1f5f9;
    border-color: #c7d1e3;
}

/* ---------------- 下拉框 ---------------- */
QComboBox {
    border: 1px solid #c7d1e3;
    border-radius: 8px;
    padding: 9px 32px 9px 14px;
    background-color: rgba(255, 255, 255, 0.9);
    color: #1e293b;
    min-width: 100px;
}

QComboBox:hover, QComboBox:focus { border-color: #4f46e5; }

QComboBox::drop-down {
    border: none;
    width: 26px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iMTIiIHZpZXdCb3g9IjAgMCAxMiAxMiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMyA0LjVMNiA3LjVMOSA0LjUiIHN0cm9rZT0iIzY0NzQ4YiIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c7d1e3;
    border-radius: 8px;
    selection-background-color: #e0e7ff;
    selection-color: #1e293b;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 9px 12px;
    border-radius: 6px;
    color: #1e293b;
    border: none;
    outline: none;
}

QComboBox QAbstractItemView::item:hover { background-color: #eef2ff; }

/* ---------------- 标签 ---------------- */
QLabel {
    color: #1e293b;
    background-color: transparent;
}

/* ---------------- 滚动区 / 滚动条 ---------------- */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover { background-color: #4f46e5; }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover { background-color: #4f46e5; }

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------------- 分割器 ---------------- */
QSplitter::handle { background-color: transparent; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }
QSplitter::handle:hover      { background-color: rgba(79, 70, 229, 0.3); }

/* ---------------- 提示框 ---------------- */
QToolTip {
    background-color: #1e293b;
    color: #f8fafc;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ---------------- 菜单 ---------------- */
QMenu {
    background-color: rgba(255, 255, 255, 0.98);
    border: 1px solid #c7d1e3;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 9px 28px 9px 14px;
    border-radius: 6px;
    color: #1e293b;
}

QMenu::item:selected {
    background-color: #e0e7ff;
    color: #4338ca;
}

QMenu::separator {
    height: 1px;
    background-color: #c7d1e3;
    margin: 5px 10px;
}

/* ---------------- 状态栏 ---------------- */
QStatusBar {
    background-color: rgba(255, 255, 255, 0.75);
    border-top: 1px solid #c7d1e3;
    color: #64748b;
    padding: 4px 16px;
    font-size: 12px;
}
